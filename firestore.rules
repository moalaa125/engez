rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // التحقق من مصادقة المستخدم
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // الأماكن
    match /places/{placeId} {
      allow read: if true; // أي شخص يقرأ
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // عناصر القائمة (تحت المجموعة الفرعية)
      match /menuItems/{menuItemId} {
        allow read: if true;
        allow create: if request.auth != null && get(/databases/$(database)/documents/places/$(placeId)).data.ownerId == request.auth.uid;
        allow update, delete: if request.auth != null && get(/databases/$(database)/documents/places/$(placeId)).data.ownerId == request.auth.uid;
      }
    }
  }
}